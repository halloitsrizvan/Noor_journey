  "verses": [
    {
      "id": "fatihah-1",
      "verseKey": "1:1",
      "number": 1,
      "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
      "audioUrl": null,
      "translation": {
        "en": "In the Name of Allah—the Most Compassionate, Most Merciful.",
        "ml": "പരമകാരുണികനും കരുണാനിധിയുമായ അല്ലാഹുവിന്റെ നാമത്തിൽ."
      },
      "annotations": []
    },
    {
      "id": "fatihah-2",
      "verseKey": "1:2",
      "number": 2,
      "textUthmani": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
      "audioUrl": null,
      "translation": {
        "en": "All praise is for Allah—Lord of all worlds.",
        "ml": "സ്തുതിയെല്ലാം സർവ്വലോക പരിപാലകനായ അല്ലാഹുവിനാകുന്നു."
      },
      "annotations": []
    },
    {
      "id": "fatihah-3",
      "verseKey": "1:3",
      "number": 3,
      "textUthmani": "ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
      "audioUrl": null,
      "translation": {
        "en": "The Most Compassionate, Most Merciful.",
        "ml": "പരമകാരുണികനും കരുണാനിധിയുമായവൻ."
      },
      "annotations": []
    },
    {
      "id": "fatihah-4",
      "verseKey": "1:4",
      "number": 4,
      "textUthmani": "مَـٰلِكِ يَوْمِ ٱلدِّينِ",
      "audioUrl": null,
      "translation": {
        "en": "Master of the Day of Judgment.",
        "ml": "പ്രതിഫല ദിവസത്തിന്റെ ഉടമസ്ഥനായവൻ."
      },
      "annotations": []
    },
    {
      "id": "fatihah-5",
      "verseKey": "1:5",
      "number": 5,
      "textUthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
      "audioUrl": null,
      "translation": {
        "en": "You alone we worship and You alone we ask for help.",
        "ml": "നിന്നെ മാത്രം ഞങ്ങൾ ആരാധിക്കുന്നു, നിന്നോട് മാത്രം ഞങ്ങൾ സഹായം തേടുന്നു."
      },
      "annotations": []
    },
    {
      "id": "fatihah-6",
      "verseKey": "1:6",
      "number": 6,
      "textUthmani": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "audioUrl": null,
      "translation": {
        "en": "Guide us along the Straight Path.",
        "ml": "ഞങ്ങളെ നീ നേരായ പാതയിൽ നയിക്കേണമേ."
      },
      "annotations": []
    },
    {
      "id": "fatihah-7",
      "verseKey": "1:7",
      "number": 7,
      "textUthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "audioUrl": null,
      "translation": {
        "en": "The path of those You have blessed—not those who have incurred Your wrath, nor those who are astray.",
        "ml": "നീ അനുഗ്രഹിച്ചവരുടെ വഴിയിൽ; കോപത്തിനിരയായവരുടെയോ വഴിപിഴച്ചവരുടെയോ വഴിയല്ല."
      },
      "annotations": []
    }
