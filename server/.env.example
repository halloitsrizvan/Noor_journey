# Neon PostgreSQL Pooled Connection (used for queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL Direct Connection (used for migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=4000

# Environment (development, production, test)
NODE_ENV=development

# Allowed Frontend Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000

# Server-side Session Management
SESSION_COOKIE_NAME=noor_session
SESSION_TTL_DAYS=7
SESSION_SECRET=change_this_session_secret_in_production_min_32_chars

# CSRF Protection
CSRF_COOKIE_NAME=noor_csrf
CSRF_HEADER_NAME=x-csrf-token

# Timezone for week boundaries & reports
APP_TIMEZONE=Asia/Kolkata

# Enable demo unreviewed content fixtures (strictly false in production)
ENABLE_DEMO_CONTENT=true
