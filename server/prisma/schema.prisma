datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Account & Access
// -------------------------------------------------------------

enum Role {
  PARENT
  AUTHOR
  REVIEWER
  ADMIN
}

model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(PARENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  children         ChildProfile[]
  auditEvents      AuditEvent[]
  consentLogs      GuardianConsentRecord[]
  reviewsDone      ContentReview[]
  publications     PublicationRecord[]
  approvedVersions MissionVersion[]        @relation("ApprovedMissionVersions")
}

model Session {
  id           String    @id @default(uuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([accountId])
}

model ChildProfile {
  id                String    @id @default(uuid())
  parentAccountId   String
  parentAccount     Account   @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  nickname          String
  ageBand           String    // "8-9", "10-11", "12-13"
  preferredLanguage String    @default("ml") // "ml", "en"
  priorStandard     String?   // "1", "2", "3", "none", "not-sure"
  avatarKey         String    @default("lantern-noor")
  weeklyGoal        Int       @default(3) // 2, 3, or 5
  timezone          String    @default("Asia/Kolkata")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attempts          MissionAttempt[]
  completions       MissionCompletion[]
  masteries         ObjectiveMastery[]
  reviews           ReviewSchedule[]
  reviewAttempts    ReviewAttempt[]
  rewards           RewardTransaction[]
  badgeAwards       BadgeAward[]
  cosmeticUnlocks   CosmeticUnlock[]
  reflections       FamilyReflection[]
  consentLogs       GuardianConsentRecord[]

  @@index([parentAccountId])
}

model GuardianConsentRecord {
  id              String       @id @default(uuid())
  parentAccountId String
  parentAccount   Account      @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  childProfileId  String?
  childProfile    ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  consentType     String       // e.g. "PILOT_DATA_PROCESSING"
  grantedAt       DateTime     @default(now())
  ipAddress       String?

  @@index([parentAccountId])
}

model AuditEvent {
  id           String    @id @default(uuid())
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  eventType    String    // e.g. "AUTH_LOGIN", "CONTENT_PUBLISHED", "PROFILE_DELETED"
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([accountId])
  @@index([eventType])
}

// -------------------------------------------------------------
// 2. Curriculum Entities (SKIMVB mapping structure)
// -------------------------------------------------------------

model CurriculumBoard {
  id        String              @id @default(uuid())
  name      String              // e.g. "Samastha Kerala Islam Matha Vidyabhyasa Board"
  code      String              @unique // "SKIMVB"
  website   String?
  editions  CurriculumEdition[]
}

model CurriculumEdition {
  id        String               @id @default(uuid())
  boardId   String
  board     CurriculumBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  year      String               // e.g. "2026"
  title     String
  standards CurriculumStandard[]
  subjects  CurriculumSubject[]
}

model CurriculumStandard {
  id             String            @id @default(uuid())
  editionId      String
  edition        CurriculumEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  standardNumber Int               // e.g. 1 to 10
  books          CurriculumBook[]

  @@unique([editionId, standardNumber])
}

model CurriculumSubject {
  id        String            @id @default(uuid())
  editionId String
  edition   CurriculumEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  code      String            // e.g. "taskiya-akhlaq", "aqaid", "fiqh"
  name      String
  books     CurriculumBook[]

  @@unique([editionId, code])
}

model CurriculumBook {
  id         String             @id @default(uuid())
  standardId String
  standard   CurriculumStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    CurriculumSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  chapters   CurriculumChapter[]
}

model CurriculumChapter {
  id            String              @id @default(uuid())
  bookId        String
  book          CurriculumBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber Int
  title         String
  objectives    LearningObjective[]
}

model LearningObjective {
  id            String                    @id @default(uuid())
  chapterId     String
  chapter       CurriculumChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  code          String                    @unique // e.g. "AKH-03-01"
  descriptionMl String
  descriptionEn String

  mappings      MissionObjectiveMapping[]
  masteries     ObjectiveMastery[]
}

// -------------------------------------------------------------
// 3. Learning Content Entities
// -------------------------------------------------------------

model World {
  id           String            @id @default(uuid())
  slug         String            @unique // "akhlaq", "foundations", "stories", "everyday", "practice"
  titleMl      String
  titleEn      String
  blurbMl      String
  blurbEn      String
  playable     Boolean           @default(false)
  displayOrder Int               @default(1)
  chapters     LearningChapter[]
}

model LearningChapter {
  id           String            @id @default(uuid())
  worldId      String
  world        World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug         String            @unique // e.g. "akhlaq-small-actions"
  titleMl      String
  titleEn      String
  descriptionMl String
  descriptionEn String
  displayOrder Int               @default(1)
  playable     Boolean           @default(false)
  missions     Mission[]
  badge        BadgeDefinition?
}

model Mission {
  id                String               @id @default(uuid())
  learningChapterId String
  learningChapter   LearningChapter      @relation(fields: [learningChapterId], references: [id], onDelete: Cascade)
  slug              String               @unique // e.g. "m1-kind-words"
  order             Int                  // 1 to 5
  titleMl           String
  titleEn           String
  conceptMl         String
  conceptEn         String
  objectiveMl       String
  objectiveEn       String
  minutes           Int                  @default(6)
  subjectId         String               // e.g. "taskiya-akhlaq"

  versions          MissionVersion[]
  prerequisites     MissionPrerequisite[] @relation("DependentMissions")
  prerequisiteFor   MissionPrerequisite[] @relation("RequiredMissions")
  completions       MissionCompletion[]
  reviews           ReviewSchedule[]
  reflections       FamilyReflection[]

  @@unique([learningChapterId, order])
}

enum PublishState {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  AWAITING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
}

model MissionVersion {
  id                 String                    @id @default(uuid())
  missionId          String
  mission            Mission                   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  versionString      String                    // e.g. "1.0.0" or "0.1-demo"
  publishState       PublishState              @default(DRAFT)
  reviewStatus       ReviewStatus              @default(AWAITING_REVIEW)
  teachingJson       Json                      // title, body paragraphs, arabic text/meaning
  activitiesJson     Json                      // ordered list of activities (choice, match, sequence)
  checkpointPoolJson Json                      // pool of questions for checkpoint
  revisionJson       Json                      // revision variants
  familyPromptMl     String
  familyPromptEn     String
  supplementary      Boolean                   @default(false)
  approvedById       String?
  approvedBy         Account?                  @relation("ApprovedMissionVersions", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime                  @default(now())

  objectiveMappings  MissionObjectiveMapping[]
  reviews            ContentReview[]
  publications       PublicationRecord[]
  attempts           MissionAttempt[]
  completions        MissionCompletion[]

  @@unique([missionId, versionString])
}

model MissionObjectiveMapping {
  id               String            @id @default(uuid())
  missionVersionId String
  missionVersion   MissionVersion    @relation(fields: [missionVersionId], references: [id], onDelete: Cascade)
  objectiveId      String
  objective        LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([missionVersionId, objectiveId])
}

model MissionPrerequisite {
  id                    String   @id @default(uuid())
  missionId             String
  mission               Mission  @relation("DependentMissions", fields: [missionId], references: [id], onDelete: Cascade)
  prerequisiteMissionId String
  prerequisiteMission   Mission  @relation("RequiredMissions", fields: [prerequisiteMissionId], references: [id], onDelete: Cascade)

  @@unique([missionId, prerequisiteMissionId])
}

model ContentReview {
  id               String         @id @default(uuid())
  missionVersionId String
  missionVersion   MissionVersion @relation(fields: [missionVersionId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         Account        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status           ReviewStatus
  comments         String?
  createdAt        DateTime       @default(now())

  @@index([missionVersionId])
}

model PublicationRecord {
  id               String         @id @default(uuid())
  missionVersionId String
  missionVersion   MissionVersion @relation(fields: [missionVersionId], references: [id], onDelete: Cascade)
  publishedById    String
  publishedBy      Account        @relation(fields: [publishedById], references: [id], onDelete: Cascade)
  publishedAt      DateTime       @default(now())
  releaseNotes     String?

  @@index([missionVersionId])
}

// -------------------------------------------------------------
// 4. Progress, Attempts, Grading & Spaced Repetition
// -------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  FAILED
  PASSED
  ABANDONED
}

model MissionAttempt {
  id               String               @id @default(uuid())
  childProfileId   String
  childProfile     ChildProfile         @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  missionVersionId String
  missionVersion   MissionVersion       @relation(fields: [missionVersionId], references: [id], onDelete: Cascade)
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  status           AttemptStatus        @default(IN_PROGRESS)
  progressRevision Int                  @default(1)

  submissions      ActivitySubmission[]
  checkpoints      CheckpointAttempt[]

  @@index([childProfileId, missionVersionId])
}

model ActivitySubmission {
  id           String         @id @default(uuid())
  attemptId    String
  attempt      MissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  activityId   String         // e.g. "m1a1"
  payloadJson  Json           // client submitted selection / order / match pairs
  isCorrect    Boolean
  feedbackMl   String
  feedbackEn   String
  submittedAt  DateTime       @default(now())

  @@index([attemptId])
}

model CheckpointAttempt {
  id          String         @id @default(uuid())
  attemptId   String
  attempt     MissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  score       Int            // e.g. 3 or 4
  maxScore    Int            @default(4)
  passed      Boolean
  passedAt    DateTime?
  answersJson Json           // answers submitted

  @@index([attemptId])
}

model MissionCompletion {
  id               String         @id @default(uuid())
  childProfileId   String
  childProfile     ChildProfile   @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  missionId        String
  mission          Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionVersionId String
  missionVersion   MissionVersion @relation(fields: [missionVersionId], references: [id], onDelete: Cascade)
  firstCompletedAt DateTime       @default(now())
  completedCount   Int            @default(1)

  @@unique([childProfileId, missionId])
  @@index([childProfileId])
}

enum MasteryState {
  NOT_STARTED
  LEARNING
  READY_TO_REVIEW
  RETAINED
}

model ObjectiveMastery {
  id             String            @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile      @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  state          MasteryState      @default(NOT_STARTED)
  updatedAt      DateTime          @updatedAt

  @@unique([childProfileId, objectiveId])
}

enum ReviewScheduleStatus {
  PENDING
  DUE
  COMPLETED
  FAILED
}

model ReviewSchedule {
  id             String               @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile         @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  missionId      String
  mission        Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stage          Int                  @default(0) // 0 (+1d), 1 (+3d), 2 (+7d)
  dueAt          DateTime
  status         ReviewScheduleStatus @default(PENDING)
  retained       Boolean              @default(false)
  lastReviewedAt DateTime?

  attempts       ReviewAttempt[]

  @@unique([childProfileId, missionId, stage])
  @@index([childProfileId, dueAt])
}

model ReviewAttempt {
  id               String         @id @default(uuid())
  reviewScheduleId String
  reviewSchedule   ReviewSchedule @relation(fields: [reviewScheduleId], references: [id], onDelete: Cascade)
  childProfileId   String
  childProfile     ChildProfile   @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  missionId        String
  answersJson      Json
  passed           Boolean
  passedAt         DateTime       @default(now())

  @@index([reviewScheduleId])
}

enum RewardReason {
  MISSION_COMPLETION
  SCHEDULED_REVIEW
  CHAPTER_REVIEW
}

model RewardTransaction {
  id             String       @id @default(uuid())
  idempotencyKey String       @unique
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  amount         Int          // 20 XP for mission, 5 XP for review
  reason         RewardReason
  referenceId    String?      // missionId or reviewId
  createdAt      DateTime     @default(now())

  @@index([childProfileId])
}

model BadgeDefinition {
  id            String          @id @default(uuid())
  chapterId     String          @unique
  chapter       LearningChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  slug          String          @unique // e.g. "badge-akhlaq-guardian"
  nameMl        String
  nameEn        String
  descriptionMl String
  descriptionEn String
  awards        BadgeAward[]
}

model BadgeAward {
  id             String          @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile    @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  badgeId        String
  badge          BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt      DateTime        @default(now())

  @@unique([childProfileId, badgeId])
}

model CosmeticDefinition {
  id      String           @id @default(uuid())
  slug    String           @unique
  nameMl  String
  nameEn  String
  type    String           // "avatar", "lantern_aura"
  unlocks CosmeticUnlock[]
}

model CosmeticUnlock {
  id             String             @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile       @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  cosmeticId     String
  cosmetic       CosmeticDefinition @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  unlockedAt     DateTime           @default(now())

  @@unique([childProfileId, cosmeticId])
}

model FamilyReflection {
  id             String       @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  missionId      String
  mission        Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  note           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([childProfileId, missionId])
}

// -------------------------------------------------------------
// 5. Madrasa Subjects, Curriculums & Quran Study
// -------------------------------------------------------------

model MadrasaSubject {
  id             String                   @id @default(uuid())
  key            String                   @unique // "tajweed", "aqeedah", "fiqh", "lisanul-quran", "akhlaq"
  englishTitle   String
  malayalamTitle String
  arabicName     String
  icon           String                   // emoji e.g. "🎙️", "🌙", "💧", "📖", "💛"
  badgeEn        String
  badgeMl        String
  shortDescEn    String
  shortDescMl    String
  bgGradient     String                   @default("bg-gradient-to-br from-[#F0E9FF] to-[#E3D4FF]")
  borderColor    String                   @default("border-[#CBB5FF]")
  textColor      String                   @default("text-[#5B21B6]")
  accentBg       String                   @default("bg-[#7857E8]")
  displayOrder   Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  topics         MadrasaCurriculumTopic[]
}

model MadrasaCurriculumTopic {
  id        String         @id @default(uuid())
  subjectId String
  subject   MadrasaSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  titleEn   String
  titleMl   String
  descEn    String
  descMl    String
  icon      String         @default("📜")
  order     Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([subjectId])
}

model FatihahVerseData {
  id                   String   @id // "fatihah-1", "fatihah-2", etc.
  verseNumber          Int      @unique
  arabicText           String
  englishTranslation   String
  malayalamTranslation String
  transliteration      String
  tajweedRulesJson     Json?
  wordsJson            Json?
  audioUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

