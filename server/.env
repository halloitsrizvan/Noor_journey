# Noor Journey Backend Environment Configuration
# Replace DATABASE_URL and DATABASE_URL_UNPOOLED with your actual Neon PostgreSQL connection string.

# Neon PostgreSQL Pooled Connection (for application queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL Direct Connection (for Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=4000

# Environment
NODE_ENV=development

# Allowed Frontend Origins (Vite dev server)
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000

# Server-side Session Management
SESSION_COOKIE_NAME=noor_session
SESSION_TTL_DAYS=7
SESSION_SECRET=noor_journey_session_secret_2026_dev_mode_32chars!!

# CSRF Protection
CSRF_COOKIE_NAME=noor_csrf
CSRF_HEADER_NAME=x-csrf-token

# Timezone for week boundaries & reports (Kerala / IST)
APP_TIMEZONE=Asia/Kolkata

# Enable demo unreviewed content fixtures (labeled DEMO_UNREVIEWED)
ENABLE_DEMO_CONTENT=true
